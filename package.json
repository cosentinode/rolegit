{
  "name": "rolegit",
  "version": "0.1.0",
  "description": "Role-based encrypted files for Git repositories.",
  "type": "module",
  "bin": {
    "rolegit": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "SECURITY.md",
    "docs/security.md",
    "docs/threat-model.md",
    "docs/adr/0001-product-modes-and-trust-boundaries.md",
    "docs/adr/0002-branches-protocols-and-repository-ownership.md",
    "README.md",
    "LICENSE",
    "server-policy.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint:commit": "commitlint",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build",
    "package:check": "npm pack --dry-run",
    "smoke": "npm run build && node dist/src/cli.js --help",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:pr-title": "node --test .github/scripts/check-pr-title.test.mjs",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
